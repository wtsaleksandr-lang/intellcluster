# IntellCluster — Environment Variables
# Copy to .env and fill in your keys. Never commit real credentials.

# ─── LLM API Keys (at least one required for synthesis features) ───
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
GOOGLE_API_KEY=AIza...
DEEPSEEK_API_KEY=sk-...
XAI_API_KEY=xai-...

# (aliases also accepted: GPT_API_KEY, CLAUDE_API_KEY, GEMINI_API_KEY, GROK_API_KEY)

# ─── Intelligence database ───
# Production should use DATABASE_URL. SQLite is useful for local preview/tests.
DATABASE_URL=
INTELLIGENCE_DB_PATH=data/intelligence.db
PUBLIC_BASE_URL=https://intellcluster.com

# ─── Data enrichment ───
# Keep enrichment lazy/cached; do not pre-enrich entire public datasets.
HUNTER_API_KEY=

# ImportYeti is a paid data source. A stored key alone MUST NOT enable spending.
# Paid network access has multiple gates: this master switch, an explicit
# ImportYetiClient(allow_live=True) call site, and confirm_paid=true on the
# dedicated acquisition endpoint. Normal page/BOL views always use cached-only
# clients even if this master switch is enabled.
IMPORTYETI_API_KEY=
IMPORTYETI_ALLOW_LIVE=false

# SEC EDGAR is free/keyless but asks automated clients to declare a User-Agent.
SEC_EDGAR_USER_AGENT=IntellCluster/1.0 contact@intellcluster.com

# Optional deterministic fixtures for local/CI enrichment testing.
EPA_ECHO_FIXTURE_PATH=
OSHA_FIXTURE_PATH=
IMPORTYETI_FIXTURE_PATH=
USASPENDING_FIXTURE_PATH=
FMCSA_FIXTURE_PATH=
SEC_EDGAR_FIXTURE_PATH=

# ─── Admin ───
ADMIN_USERNAME=admin@intellcluster.com
ADMIN_PASSWORD=change-this-password
ADMIN_SECRET_KEY=change-this-to-random-32-char-string

# ─── Server ───
PORT=5000
DEBUG=false
COST_PROFILE=cheap

# ─── Rate limiting ───
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=30

# ─── Stripe (fill in when ready to charge) ───
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Price IDs — create products in Stripe Dashboard, paste IDs here
STRIPE_PRICE_STARTER_MONTHLY=
STRIPE_PRICE_STARTER_ANNUAL=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_ANNUAL=
STRIPE_PRICE_CREDITS_5=
STRIPE_PRICE_CREDITS_15=
STRIPE_PRICE_CREDITS_30=

# ─── Email (optional — for waitlist confirmations) ───
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@intellcluster.com

# ─── Analytics (optional — Plausible) ───
PLAUSIBLE_DOMAIN=
